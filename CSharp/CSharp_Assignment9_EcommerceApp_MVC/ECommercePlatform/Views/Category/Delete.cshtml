@model ECommercePlatform.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<h1>Delete Category</h1>

@if (Model.Products != null && Model.Products.Any())
{
    <div class="alert alert-warning">
        <strong>⚠️ Warning!</strong> This category has @Model.Products.Count products.
        You cannot delete it until you move or delete these products.
    </div>
}

<div class="alert alert-danger">
    <h3>Are you sure you want to delete this category?</h3>
</div>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>
        
        <dt class="col-sm-2">Created Date</dt>
        <dd class="col-sm-10">@Model.CreatedDate.ToShortDateString()</dd>
        
        @if (Model.Products != null && Model.Products.Any())
        {
            <dt class="col-sm-2">Products</dt>
            <dd class="col-sm-10">
                <ul>
                    @foreach (var product in Model.Products)
                    {
                        <li>@product.Name</li>
                    }
                </ul>
            </dd>
        }
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        @if (Model.Products != null && Model.Products.Any())
        {
            <input type="submit" value="Delete" class="btn btn-danger" disabled />
            <span class="text-muted">Cannot delete category with products</span>
        }
        else
        {
            <input type="submit" value="Delete" class="btn btn-danger" />
        }
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>